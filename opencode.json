{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "opencode/big-pickle",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "default_agent": "build",
  "autoupdate": "notify",
  "domain": {},
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf /*": "deny"
    },
    "external_directory": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
