# Servidor
HOST=0.0.0.0
PORT=8787
DATA_DIR=/app/data

# Auth del super-admin (token que se pide en el chat). CAMBIAR EN PROD.
ADMIN_TOKEN=change-me

# Ruta al repo del sistema dentro del contenedor (para memoria e índice)
SYSTEM_REPO_ROOT=/app

# Model router: orden de proveedores (gratis primero)
MODEL_ORDER=opencode,opencode-go
ZEN_MODELS_URL=https://opencode.ai/zen/v1/models
MAX_TOKENS_PER_TASK=200000
BUDGET_USD_DAILY=5

# Modo de agente: simulate | opencode
AGENT_MODE=simulate
OPENCODE_BIN=opencode

# Sandbox: none | docker
SANDBOX_MODE=none
SANDBOX_IMAGE=ghcr.io/sistema/sandbox:latest

# Dokploy (deploy)
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_PROJECT_ID=
DOKPLOY_ENVIRONMENT_ID=

# GitHub (para push de ramas del agente)
GITHUB_TOKEN=

# Si es "1", no ejecuta deploys reales (solo simula)
DRY_RUN=0
